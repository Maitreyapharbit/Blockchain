{
  "name": "pharma-blockchain-system",
  "version": "1.0.0",
  "description": "Comprehensive Recall Management and Anti-Counterfeiting system for pharmaceutical blockchain application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "test:contracts": "cd contracts && npx hardhat test",
    "deploy:contracts": "cd contracts && npx hardhat run scripts/deploy.js --network localhost",
    "sync-env": "node sync-env.js",
    "sync-env:frontend": "node sync-env.js --frontend-only",
    "sync-env:contracts": "node sync-env.js --contracts-only"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ]
}